# העתק את הקובץ הזה לשם .env (באותה תיקייה) ועדכן ערכים לפי הצורך.
# כל השורות כאן אופציונליות - המערכת עובדת גם בלי .env.

PORT=4000
WEB_ORIGIN=http://localhost:3000

# אדמין ראשוני (נוצר רק בהפעלה הראשונה). לפני פרסום לאינטרנט - חובה להחליף!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# סוד להצפנת טוקנים. בפרסום - חובה. אפשר ליצור: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# יצירת פעולות באמצעות Claude (לא חובה; בלי מפתח המערכת משתמשת במחולל תבניות מובנה)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# מייל לאדמין בכל פעולה חדשה (לא חובה; בלי SMTP המייל רק נרשם בלוג)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_EMAIL=

# ── חשבונות מדריכים ──
# קוד הרשמה שהשבט נותן למדריכים. אם ריק בפרסום ציבורי - ההרשמה סגורה והאדמין פותח חשבונות ידנית.
SIGNUP_CODE=
# כמה ימים נשארים מחוברים (מדריכים)
INSTRUCTOR_TOKEN_DAYS=30

# ── גיבוי אוטומטי של מסד הנתונים ──
# כל כמה שעות (0 = כבוי), כמה גיבויים לשמור, ותיקייה (ברירת מחדל: backups ליד מסד הנתונים)
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=14
BACKUP_DIR=
# מיקום מסד הנתונים. בשרת עם דיסק קבוע: /data/scout.db
DB_PATH=./data/scout.db

# כתובת האתר הציבורית (קישורים בקובץ היומן)
PUBLIC_URL=
