# מעתיקים ל-.env ומשנים את הערכים (בשרת: cp .env.example .env ואז nano .env)
# הרשימה המלאה של המשתנים נמצאת ב-backend/.env.example
DOMAIN=activities.example.com
PUBLIC_URL=https://activities.example.com
JWT_SECRET=שימו-כאן-טקסט-אקראי-ארוך-של-64-תווים
ADMIN_PASSWORD=סיסמה-חזקה-לאדמין
# לא חובה:
# ANTHROPIC_API_KEY=
