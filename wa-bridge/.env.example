# הגדרות הגשר. הדרך הקלה: להריץ setup-bridge.bat והוא יכתוב את הקובץ בשבילך
# (הוא נשמר בתיקיית המשתמש, מחוץ לפרויקט, כך שלא ניתן להעלות אותו בטעות ל-GitHub).

# כתובת האתר שלך
SITE_URL=https://shevet-maoz-app.onrender.com

# אסימון הגשר שנוצר במרכז הוואטסאפ באתר (מתחיל ב-wb_). מוצג פעם אחת בלבד.
BRIDGE_TOKEN=wb_000000000000000000000000000000000000000000000000

# openwa = וואטסאפ אמיתי | mock = הדמיה לבדיקות (בלי וואטסאפ)
ADAPTER=openwa

# להציג את חלון הדפדפן בזמן החיבור (true/false). ברירת מחדל: false
SHOW_BROWSER=false

# אופציונלי: נתיב ל-Chrome אם לא נמצא אוטומטית
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# אופציונלי: איפה נשמרים נתוני החיבור. ברירת מחדל: תיקיית המשתמש, מחוץ לפרויקט
# DATA_DIR=C:\Users\me\.maoz-wa-bridge
